{
  "name": "government-news-pipeline",
  "version": "0.1.0",
  "private": true,
  "description": "Batch pipeline for government news",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=20.0.0 <25.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run --exclude 'tests/integration/**' --passWithNoTests",
    "test:watch": "vitest --exclude 'tests/integration/**'",
    "test:integration": "vitest run tests/integration --passWithNoTests",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.31.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.37.0",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.800.0",
    "zod": "^3.25.76"
  }
}
