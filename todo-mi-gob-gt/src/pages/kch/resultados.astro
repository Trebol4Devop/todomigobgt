---
import Layout from '../../layouts/Layout.astro';
import { useTranslations, getLocalizedPath } from '../../i18n/utils';
import { getNoticiasData } from '../../services/noticias';

const t = useTranslations('kch');
const searchUrl = getLocalizedPath('/buscar', 'kch');
const categoriesUrl = getLocalizedPath('/categorias', 'kch');
const detailBaseUrl = getLocalizedPath('/detalle', 'kch');
const currentSearch = Astro.url.searchParams.get('q') || '';
const noticiasData = await getNoticiasData();
const categorias = noticiasData.availableCategories || [];
const noticias = noticiasData.news || [];
---

<Layout title="K'ulmatajem · TODOMIGOBGT">
  <!-- Vista 4: Resultados con Motor de Relevancia 100% Frontend en K'iche' -->
  <section class="flex-1 flex flex-col items-center px-4 py-4 sm:py-6 max-w-2xl mx-auto w-full">
    
    <!-- Barra superior: Botón Volver y Botón de Preferencias (K'iche') -->
    <div class="w-full flex items-center justify-between mb-3 sm:mb-4">
      <a
        href={searchUrl}
        class="inline-flex w-10 h-10 sm:w-11 sm:h-11 rounded-full border-2 border-[#4997D0] items-center justify-center text-[#4997D0] dark:text-sky-300 hover:bg-[#4997D0] hover:text-white transition-all cursor-pointer bg-white dark:bg-[#202020] shadow-xs hover:scale-105 active:scale-95 group"
        aria-label="Tzalijik"
        title="Tzalijik"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 group-hover:-translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M15 19l-7-7 7-7" />
        </svg>
      </a>

      <!-- Botón superior de Preferencias (K'iche') -->
      <a
        href={categoriesUrl}
        class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full border-2 border-[#4997D0] text-sm font-bold text-[#4997D0] dark:text-sky-300 hover:bg-[#4997D0] hover:text-white transition-all bg-white dark:bg-[#202020] shadow-xs hover:scale-105 active:scale-95 cursor-pointer"
        title="Ucha'ik taq uwach patan"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" />
        </svg>
        <span>{t('preferences.button')}</span>
      </a>
    </div>

    <!-- Barra de estado de filtro de preferencias activo (K'iche') -->
    <div id="active-pref-banner" class="hidden w-full mb-3 px-3.5 py-2 rounded-xl bg-sky-50 dark:bg-sky-950/60 border border-[#4997D0]/30 text-xs sm:text-sm text-neutral-700 dark:text-neutral-200 flex items-center justify-between">
      <div class="flex items-center gap-2">
        <span class="inline-block w-2 h-2 rounded-full bg-[#4997D0]"></span>
        <span id="pref-banner-text">Taq cha'om k'ulmatajem utz kacha'o</span>
      </div>
      <a href={categoriesUrl} class="font-bold text-[#4997D0] dark:text-sky-300 hover:underline">
        K'exa' →
      </a>
    </div>

    <!-- Panel rectangular con lista de resultados clasificados por relevancia -->
    <div class="w-full border-2 border-[#4997D0] rounded-2xl p-4 sm:p-6 bg-white dark:bg-[#202020] mb-5 shadow-sm">
      <div id="results-container" class="space-y-3.5">
        {noticias.map((item) => {
          const catId = item.categoryId || item.categoriaId;
          const cat = categorias.find((c) => c.id === catId);
          const catName = cat?.nameKch || cat?.nombreKch || cat?.name || cat?.nombre || item.source || item.fuente || '';
          const content = item.content?.quc || item.content?.kch || item.content?.es || item.contenido?.quc || item.contenido?.es || {};
          const title = content.title || content.titulo || '';
          const summary = content.summary || content.resumen || '';
          const tags = item.tags || item.etiquetas || [];
          const source = item.source || item.fuente || '';
          const isUrgent = item.urgent !== undefined ? item.urgent : (item.urgente || false);
          const itemImage = item.imageUrl || item.imagenUrl || '';
          return (
            <a
              href={currentSearch ? `${detailBaseUrl}?id=${item.id}&q=${encodeURIComponent(currentSearch)}` : `${detailBaseUrl}?id=${item.id}`}
              data-id={item.id}
              data-category={catId}
              data-category-name={catName}
              data-source={source}
              data-urgent={isUrgent ? 'true' : 'false'}
              data-published={item.publishedAt || item.fechaPublicacion || ''}
              data-tags={tags.join(' ')}
              data-title={title}
              data-summary={summary}
              data-raw-title={title}
              data-raw-summary={summary}
              class="result-card block p-4 rounded-xl border border-neutral-200 dark:border-neutral-800 hover:border-[#4997D0] dark:hover:border-[#4997D0] hover:bg-sky-50/50 dark:hover:bg-neutral-800/60 transition-colors group cursor-pointer"
            >
              <div class="flex items-center justify-between gap-2 mb-2">
                <span class="text-xs sm:text-sm font-bold text-[#4997D0] dark:text-sky-400">
                  {catName}
                </span>
                <div class="flex items-center gap-1.5">
                  {isUrgent && (
                    <span class="px-2 py-0.5 rounded text-xs font-bold bg-red-100 text-red-700 dark:bg-red-950 dark:text-red-300 border border-red-300">
                      Aninaq
                    </span>
                  )}
                  <button
                    type="button"
                    class="js-card-speak-btn inline-flex items-center justify-center w-7 h-7 rounded-full text-neutral-400 hover:text-[#4997D0] hover:bg-sky-50 dark:hover:bg-neutral-700 transition-colors cursor-pointer"
                    title="Utatab'exik / Escuchar"
                    aria-label="Utatab'exik / Escuchar"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M15.536 8.464a5 5 0 010 7.072M18.364 5.636a9 9 0 010 12.728M11 5L6 9H2v6h4l5 4V5z" />
                    </svg>
                  </button>
                </div>
              </div>

              <div class="flex gap-3 sm:gap-4 items-start">
                <div class="flex-1 min-w-0">
                  <h2 class="result-title text-lg sm:text-xl font-bold text-neutral-900 dark:text-white group-hover:text-[#4997D0] transition-colors leading-snug">
                    {title}
                  </h2>
                  <p class="result-summary text-sm sm:text-base text-neutral-700 dark:text-neutral-300 mt-1.5 leading-relaxed line-clamp-3 sm:line-clamp-2">
                    {summary}
                  </p>
                </div>
                {itemImage && (
                  <div class="card-image-container shrink-0 w-20 h-20 sm:w-24 sm:h-24 rounded-xl overflow-hidden border border-neutral-200 dark:border-neutral-700 bg-sky-50/40 dark:bg-neutral-800">
                    <img
                      src={itemImage}
                      alt={title}
                      loading="lazy"
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                      onerror="this.parentElement.style.display='none'"
                    />
                  </div>
                )}
              </div>
            </a>
          );
        })}
      </div>

      <div id="empty-state" class="hidden py-8 text-center">
        <p class="text-base font-bold text-neutral-600 dark:text-neutral-300">
          Man xriqitaj ta jas katzukuj.
        </p>
      </div>
    </div>

    <!-- Segundo campo de búsqueda y botón -->
    <form id="search-form" action="/kch/resultados" method="GET" class="w-full flex flex-col items-center gap-3.5">
      <div class="w-full">
        <input
          id="search-input"
          type="text"
          name="q"
          value={currentSearch}
          placeholder={t('results.placeholder')}
          class="w-full px-4 py-3 sm:py-3.5 border-2 border-[#4997D0] rounded-xl text-base sm:text-lg text-neutral-900 dark:text-white placeholder:text-neutral-400 dark:placeholder:text-neutral-500 focus:outline-none focus:ring-2 focus:ring-[#4997D0] bg-white dark:bg-[#202020] shadow-xs"
        />
      </div>

      <button
        type="submit"
        class="w-40 sm:w-48 py-3 px-6 bg-[#4997D0] hover:bg-sky-600 text-white font-bold text-base sm:text-lg rounded-xl transition-colors cursor-pointer shadow-md active:translate-y-0.5"
      >
        {t('search.button')}
      </button>
    </form>

    <!-- Área de 'Noticias sugeridas por tus preferencias' (abajo del buscador en K'iche') -->
    <div id="suggested-section" class="w-full mt-6 pt-5 border-t border-neutral-200 dark:border-neutral-800">
      <div class="flex items-center justify-between mb-3">
        <div>
          <h3 id="suggested-title" class="text-base sm:text-lg font-bold text-neutral-900 dark:text-white">
            Taq ch'ob'oj che utz kacha'o
          </h3>
          <p id="suggested-desc" class="text-sm text-neutral-600 dark:text-neutral-400">
            Patan xuquje' k'ulmatajem rech taq awach cha'om
          </p>
        </div>
      </div>

      <div id="suggested-container" class="space-y-3">
        {noticias.map((item) => {
          const catId = item.categoryId || item.categoriaId;
          const cat = categorias.find((c) => c.id === catId);
          const catName = cat?.nameKch || cat?.nombreKch || cat?.name || cat?.nombre || item.source || item.fuente || '';
          const content = item.content?.quc || item.content?.kch || item.content?.es || item.contenido?.quc || item.contenido?.es || {};
          const title = content.title || content.titulo || '';
          const summary = content.summary || content.resumen || '';
          const tags = item.tags || item.etiquetas || [];
          const itemImage = item.imageUrl || item.imagenUrl || '';
          return (
            <a
              href={currentSearch ? `${detailBaseUrl}?id=${item.id}&q=${encodeURIComponent(currentSearch)}` : `${detailBaseUrl}?id=${item.id}`}
              data-id={item.id}
              data-category={catId}
              data-title={title}
              data-summary={summary}
              data-tags={tags.join(' ')}
              class="suggested-card block p-3.5 rounded-xl border border-neutral-200 dark:border-neutral-800 hover:border-[#4997D0] dark:hover:border-[#4997D0] bg-white dark:bg-[#202020] hover:bg-sky-50/50 dark:hover:bg-neutral-800/60 transition-colors group cursor-pointer"
            >
              <div class="flex items-center justify-between gap-2 mb-1.5">
                <span class="text-xs sm:text-sm font-bold text-[#4997D0] dark:text-sky-400">
                  {catName}
                </span>
                <div class="flex items-center gap-2">
                  <button
                    type="button"
                    class="js-card-speak-btn inline-flex items-center justify-center w-7 h-7 rounded-full text-neutral-400 hover:text-[#4997D0] hover:bg-sky-50 dark:hover:bg-neutral-700 transition-colors cursor-pointer"
                    title="Utatab'exik / Escuchar"
                    aria-label="Utatab'exik / Escuchar"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M15.536 8.464a5 5 0 010 7.072M18.364 5.636a9 9 0 010 12.728M11 5L6 9H2v6h4l5 4V5z" />
                    </svg>
                  </button>
                  <span class="text-xs sm:text-sm text-neutral-500 dark:text-neutral-400 group-hover:text-[#4997D0] dark:group-hover:text-sky-300 transition-colors font-medium">
                    Chajij →
                  </span>
                </div>
              </div>

              <div class="flex gap-3 items-start">
                <div class="flex-1 min-w-0">
                  <h4 class="text-base sm:text-lg font-bold text-neutral-900 dark:text-white group-hover:text-[#4997D0] transition-colors leading-snug">
                    {title}
                  </h4>
                  <p class="text-sm text-neutral-600 dark:text-neutral-300 mt-1 line-clamp-2 leading-relaxed">
                    {summary}
                  </p>
                </div>
                {itemImage && (
                  <div class="card-image-container shrink-0 w-16 h-16 sm:w-20 sm:h-20 rounded-xl overflow-hidden border border-neutral-200 dark:border-neutral-700 bg-sky-50/40 dark:bg-neutral-800">
                    <img
                      src={itemImage}
                      alt={title}
                      loading="lazy"
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                      onerror="this.parentElement.style.display='none'"
                    />
                  </div>
                )}
              </div>
            </a>
          );
        })}
      </div>
    </div>

  </section>
</Layout>

<!-- Motor de búsqueda y ordenamiento por relevancia 100% en Frontend (K'iche') -->
<script is:inline define:vars={{ detailBaseUrl }}>
  const urlParams = new URLSearchParams(window.location.search);
  const qFromUrl = (urlParams.get('q') || '').trim();
  let preferredCats = [];
  
  try {
    const saved = localStorage.getItem('todomigob_categories');
    if (saved) {
      preferredCats = JSON.parse(saved);
      if (!Array.isArray(preferredCats)) preferredCats = [];
    }
  } catch (e) {
    preferredCats = [];
  }

  const catsFromUrl = urlParams.get('cats');
  if (catsFromUrl) {
    const splitCats = catsFromUrl.split(',').map(c => c.trim()).filter(Boolean);
    if (splitCats.length > 0) {
      preferredCats = splitCats;
      try {
        localStorage.setItem('todomigob_categories', JSON.stringify(preferredCats));
      } catch (e) {}
    }
  }

  const activePrefBanner = document.getElementById('active-pref-banner');
  if (activePrefBanner) {
    activePrefBanner.classList.toggle('hidden', preferredCats.length === 0);
  }

  const input = document.getElementById('search-input');
  if (input && qFromUrl) {
    input.value = qFromUrl;
  }

  const resultsContainer = document.getElementById('results-container');
  const primaryCards = Array.from(document.querySelectorAll('#results-container .result-card'));
  const suggestedCards = Array.from(document.querySelectorAll('#suggested-container .suggested-card'));
  const emptyState = document.getElementById('empty-state');
  const suggestedSection = document.getElementById('suggested-section');
  const suggestedTitle = document.getElementById('suggested-title');
  const suggestedDesc = document.getElementById('suggested-desc');
  const form = document.getElementById('search-form');

  if (suggestedTitle && suggestedDesc) {
    if (preferredCats.length > 0) {
      suggestedTitle.textContent = "Taq ch'ob'oj che utz kacha'o";
      suggestedDesc.textContent = "Patan xuquje' k'ulmatajem rech taq awach cha'om";
    } else {
      suggestedTitle.textContent = "Taq ch'ob'oj che utz kacha'o";
      suggestedDesc.textContent = "Juntaq chik patan xuquje' ub'ixik";
    }
  }

  // Normalización adaptada para K'iche' y español
  function normalize(str) {
    if (!str) return '';
    return str
      .toLowerCase()
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .replace(/['’`]/g, '')
      .trim();
  }

  // Palabras de transición en K'iche' y español
  const STOP_WORDS = new Set([
    'rech', 'le', 'pa', 'ri', 'che', 'ruk', 'xuquje', 'taq', 'chi', 'we',
    'de', 'la', 'el', 'en', 'y', 'a', 'los', 'las', 'un', 'una', 'del'
  ]);

  // Distancia Levenshtein para tolerancia a errores de escritura
  function levenshtein(a, b) {
    if (a === b) return 0;
    if (a.length === 0) return b.length;
    if (b.length === 0) return a.length;
    const matrix = [];
    for (let i = 0; i <= b.length; i++) matrix[i] = [i];
    for (let j = 0; j <= a.length; j++) matrix[0][j] = j;
    for (let i = 1; i <= b.length; i++) {
      for (let j = 1; j <= a.length; j++) {
        if (b.charAt(i - 1) === a.charAt(j - 1)) {
          matrix[i][j] = matrix[i - 1][j - 1];
        } else {
          matrix[i][j] = Math.min(
            matrix[i - 1][j - 1] + 1,
            matrix[i][j - 1] + 1,
            matrix[i - 1][j] + 1
          );
        }
      }
    }
    return matrix[b.length][a.length];
  }

  function highlightText(rawText, tokens) {
    if (!tokens || tokens.length === 0 || !rawText) return rawText;
    const escapedTokens = tokens
      .filter(t => t.length > 1 && !STOP_WORDS.has(t))
      .map(t => t.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'));
    if (escapedTokens.length === 0) return rawText;
    
    const regex = new RegExp(`(${escapedTokens.join('|')})`, 'gi');
    return rawText.replace(regex, '<mark class="bg-sky-100 dark:bg-sky-950 text-[#4997D0] dark:text-sky-300 px-0.5 rounded font-semibold">$1</mark>');
  }

  function scoreCard(card, normQuery, tokens, activeTokens) {
    if (!normQuery) return 1;

    const title = card.getAttribute('data-title') || '';
    const summary = card.getAttribute('data-summary') || '';
    const tags = (card.getAttribute('data-tags') || '').split(/\s+/);
    const category = card.getAttribute('data-category-name') || '';
    const source = card.getAttribute('data-source') || '';
    const isUrgent = card.getAttribute('data-urgent') === 'true';

    const normTitle = normalize(title);
    const normSummary = normalize(summary);
    const normCategory = normalize(category);
    const normSource = normalize(source);
    const normTags = tags.map(t => normalize(t));

    let score = 0;
    let matchedCount = 0;

    // 1. Coincidencia de frase exacta
    if (normTitle.includes(normQuery)) score += 150;
    if (normTags.some(t => t === normQuery || t.includes(normQuery))) score += 110;
    if (normSummary.includes(normQuery)) score += 40;

    const titleWords = normTitle.split(/\s+/);
    const summaryWords = normSummary.split(/\s+/);

    for (const token of activeTokens) {
      let matched = false;

      if (titleWords.includes(token)) {
        score += 50;
        matched = true;
      } else if (titleWords.some(w => w.startsWith(token))) {
        score += 30;
        matched = true;
      } else if (normTitle.includes(token)) {
        score += 15;
        matched = true;
      }

      if (normTags.some(t => t === token)) {
        score += 45;
        matched = true;
      } else if (normTags.some(t => t.startsWith(token) || t.includes(token))) {
        score += 25;
        matched = true;
      }

      if (normSource.includes(token)) {
        score += 35;
        matched = true;
      }

      if (normCategory.includes(token)) {
        score += 30;
        matched = true;
      }

      if (summaryWords.includes(token)) {
        score += 15;
        matched = true;
      } else if (normSummary.includes(token)) {
        score += 6;
        matched = true;
      }

      if (!matched && token.length >= 4) {
        const titleTypo = titleWords.some(w => Math.abs(w.length - token.length) <= 1 && levenshtein(w, token) <= 1);
        const tagTypo = normTags.some(t => Math.abs(t.length - token.length) <= 1 && levenshtein(t, token) <= 1);
        if (titleTypo || tagTypo) {
          score += 20;
          matched = true;
        }
      }

      if (matched) matchedCount++;
    }

    if (activeTokens.length > 1) {
      const coverage = matchedCount / activeTokens.length;
      if (coverage === 1.0) {
        score *= 2.2;
      } else if (coverage >= 0.5) {
        score *= 1.3;
      } else {
        score *= 0.5;
      }
    }

    if (isUrgent && score > 0) {
      score += 5;
    }

    return score;
  }

  function applyFilter() {
    const rawQuery = (input ? input.value : qFromUrl).trim();
    const normQuery = normalize(rawQuery);

    const tokens = normQuery ? normQuery.split(/\s+/).filter(t => t.length > 0) : [];
    const meaningfulTokens = tokens.filter(t => !STOP_WORDS.has(t) && t.length > 1);
    const activeTokens = meaningfulTokens.length > 0 ? meaningfulTokens : tokens;

    // Filtrar tarjetas principales: si hay preferencias activas, SOLO mostrar las categorías elegidas
    const eligibleCards = primaryCards.filter(card => {
      const cardCat = card.getAttribute('data-category') || '';
      const matchesCategory = preferredCats.length === 0 || preferredCats.includes(cardCat);
      if (!matchesCategory) {
        card.classList.add('hidden');
        return false;
      }
      return true;
    });

    const scoredCards = eligibleCards.map(card => {
      const score = scoreCard(card, normQuery, tokens, activeTokens);
      return { card, score };
    });

    scoredCards.sort((a, b) => b.score - a.score);

    let primaryVisible = 0;
    scoredCards.forEach(({ card, score }) => {
      const titleEl = card.querySelector('.result-title');
      const summaryEl = card.querySelector('.result-summary');
      const rawTitle = card.getAttribute('data-raw-title') || '';
      const rawSummary = card.getAttribute('data-raw-summary') || '';
      const cardId = card.getAttribute('data-id');

      if (cardId) {
        card.href = rawQuery
          ? `${detailBaseUrl}?id=${encodeURIComponent(cardId)}&q=${encodeURIComponent(rawQuery)}`
          : `${detailBaseUrl}?id=${encodeURIComponent(cardId)}`;
      }

      if (!rawQuery) {
        card.classList.remove('hidden');
        primaryVisible++;
        if (titleEl) titleEl.textContent = rawTitle;
        if (summaryEl) summaryEl.textContent = rawSummary;
      } else if (score > 0) {
        card.classList.remove('hidden');
        primaryVisible++;
        if (titleEl) titleEl.innerHTML = highlightText(rawTitle, activeTokens);
        if (summaryEl) summaryEl.innerHTML = highlightText(rawSummary, activeTokens);
      } else {
        card.classList.add('hidden');
      }

      resultsContainer?.appendChild(card);
    });

    if (emptyState) {
      emptyState.classList.toggle('hidden', primaryVisible > 0);
    }

    try {
      const currentUrl = new URL(window.location.href);
      if (rawQuery) {
        currentUrl.searchParams.set('q', rawQuery);
      } else {
        currentUrl.searchParams.delete('q');
      }
      window.history.replaceState(null, '', currentUrl.toString());
    } catch (e) {}

    let suggestedVisible = 0;
    suggestedCards.forEach((card) => {
      const cardCat = card.getAttribute('data-category') || '';
      const cardId = card.getAttribute('data-id');
      if (cardId) {
        card.href = rawQuery
          ? `${detailBaseUrl}?id=${encodeURIComponent(cardId)}&q=${encodeURIComponent(rawQuery)}`
          : `${detailBaseUrl}?id=${encodeURIComponent(cardId)}`;
      }

      const matchesPreference = preferredCats.length > 0 
        ? preferredCats.includes(cardCat)
        : (!rawQuery);

      if (matchesPreference) {
        card.classList.remove('hidden');
        suggestedVisible++;
      } else {
        card.classList.add('hidden');
      }
    });

    if (suggestedSection) {
      suggestedSection.classList.toggle('hidden', suggestedVisible === 0);
    }
  }

  input?.addEventListener('input', () => {
    applyFilter();
  });

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    applyFilter();
  });

  // Narrador de voz para tarjetas de resultados (K'iche')
  document.addEventListener('click', (e) => {
    const speakBtn = e.target.closest('.js-card-speak-btn');
    if (speakBtn) {
      e.preventDefault();
      e.stopPropagation();
      const card = speakBtn.closest('a.result-card') || speakBtn.closest('a');
      if (card) {
        const title = card.getAttribute('data-raw-title') || card.querySelector('h2, h4')?.innerText || '';
        const summary = card.getAttribute('data-raw-summary') || card.querySelector('p')?.innerText || '';
        const category = card.getAttribute('data-category-name') || '';
        const textToRead = `${title}. ${category}. ${summary}`;
        if (window.VoiceNarrator) {
          window.VoiceNarrator.speak(textToRead, card);
        }
      }
    }
  });

  applyFilter();
</script>
