# Configuracion de TODOMIGOBGT para Raspberry Pi 4

# Servidor de Base de Datos SQLite
DB_PATH=todomigobgt.db

# Servidor Web y API
HOST=0.0.0.0
PORT=8080

# Servidor SMTP de Correo (Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# Correo de Gmail de donde se enviaran las alertas (Coloca aqui tu correo de Google)
SMTP_USER=tu_correo_gmail@gmail.com

# Contrasena de aplicacion generada en tu cuenta de Google para la app 'todomigobgt'
SMTP_PASS=lykc jsej osgf ezee
SMTP_APP_NAME=todomigobgt

# Nombre visible del remitente
SENDER_NAME=TODOMIGOBGT Alertas Ciudadanas
